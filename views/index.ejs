<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Image Uploader Project</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="container">
        <h1>Image Uploader</h1>

        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <form action="/upload" method="post" enctype="multipart/form-data" class="upload-form">
            <div class="form-group">
                <input type="file" name="file" id="image" accept="image/*" required>
            </div>
            <div class="form-group">
                <button type="submit">Upload</button>
            </div>
        </form>

        <% if (url) { %>
            <div class="uploader-image-container">
                <h2>Uploaded successfully</h2>
                <img src="<%= url %>" alt="Uploaded Image">
            </div>
        <% } %>

        <h2 class="gallery-heading">Gallery</h2>
        <% if (images.length === 0) { %>
            <p class="empty-state">No images uploaded yet.</p>
        <% } else { %>
            <div class="gallery">
                <% images.forEach(function(img) { %>
                    <div class="gallery-item">
                        <img src="<%= img.imgUrl %>" alt="<%= img.filename %>">
                        <p class="filename"><%= img.filename %></p>
                        <form action="/delete/<%= img._id %>" method="post">
                            <button type="submit" class="delete-btn">Delete</button>
                        </form>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</body>

</html>
